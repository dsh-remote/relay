{
  "name": "@dsh-remote/relay",
  "version": "3.0.8",
  "description": "DSH Remote Control 的零知识 WebSocket 中继：只做路由，不碰载荷明文。可自托管的单文件产物。",
  "type": "module",
  "license": "MIT",
  "author": "dsh-remote",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-remote/relay.git"
  },
  "homepage": "https://github.com/dsh-remote/relay#readme",
  "bugs": {
    "url": "https://github.com/dsh-remote/relay/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "remote-control",
    "relay",
    "websocket",
    "zero-knowledge",
    "self-hosted"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/bundle/main.js",
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json && node scripts/bundle-relay.mjs",
    "start": "node dist/bundle/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node scripts/bundle-relay.mjs && node --test --test-timeout=60000 \"tests/*.test.mjs\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {},
  "devDependencies": {
    "@dsh-remote/protocol": "^3.0.0",
    "@types/node": "^26.6.3",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.28.2",
    "prettier": "^3.3.3",
    "typescript": "^7.0.2",
    "ws": "^8.18.0"
  },
  "packageManager": "pnpm@11.7.0",
  "bin": {
    "dsh-remote-relay": "./dist/bundle/main.js"
  },
  "files": [
    "dist/bundle",
    "deploy",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
